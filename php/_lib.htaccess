# Code interne de l'API : jamais accessible directement depuis le Web.
# Source maintenable : php/_lib.htaccess, copiée en dist/api/_lib/.htaccess par
# scripts/build-php-api.mjs. Seconde barrière : le .htaccess racine.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>

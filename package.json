    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "astro-eslint-parser": "3.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",

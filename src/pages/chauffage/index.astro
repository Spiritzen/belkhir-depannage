---
/**
 * Page métier « Chauffage » — réplication du pattern validé de
 * `/plomberie/` (PROMPT_CLAUDE_CODE_PAGE_CHAUFFAGE_PATTERN_COMPLET.txt,
 * 04/09/2026). Même assemblage de coquille (BaseLayout + bande de
 * disponibilité + navbar + tiroir mobile + footer + barre d'appel mobile,
 * tous réutilisés à l'identique), même six sections dans le même ordre, en
 * réutilisant les composants génériques et paramétrables construits pour
 * Plomberie — aucun composant dupliqué au-delà du Hero (voir son
 * commentaire d'en-tête).
 *
 * Alternance stricte des fonds, après le Hero photographique :
 *   1. urgences-chauffage      — blanc abricot (+ encart sécurité gaz/CO)
 *   2. appel-chauffage         — noir/charbon + lueur orange
 *   3. prise-en-charge-chauffage — blanc abricot (Process, tone="light")
 *   4. zone-chauffage          — noir/charbon + lueur orange
 *   5. avis-chauffage          — blanc abricot (Reviews, tone par défaut)
 *   6. faq-chauffage           — noir/charbon + lueur orange (Faq, tone="dark")
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AvailabilityBar from '../../components/layout/AvailabilityBar.astro';
import Navbar from '../../components/layout/Navbar.astro';
import MobileDrawer from '../../components/layout/MobileDrawer.astro';
import Footer from '../../components/layout/Footer.astro';
import MobileCallBar from '../../components/layout/MobileCallBar.astro';
import Hero from '../../components/chauffage/Hero.astro';
import SafetyTips from '../../components/sections/SafetyTips.astro';
import SafetyAlert from '../../components/sections/SafetyAlert.astro';
import ReassuranceCallout from '../../components/sections/ReassuranceCallout.astro';
import CoverageSummary from '../../components/sections/CoverageSummary.astro';
import Process from '../../components/landing/Process.astro';
import Reviews from '../../components/landing/Reviews.astro';
import Faq from '../../components/landing/Faq.astro';
import { siteConfig } from '../../lib/site-config';
import { coverageZones } from '../../data/landing';
import { buildFaqPageSchema } from '../../lib/seo';
import {
  chauffageSafetyTips,
  chauffageSafetyNote,
  chauffageSafetyAlertTitle,
  chauffageSafetyAlertText,
  chauffageSafetyAlertAdditionalText,
  chauffageSafetyAlertContacts,
  chauffageSafetyAlertDisclaimer,
  chauffageReassurancePoints,
  chauffageProcessSteps,
  chauffageCoverageIntro,
  chauffageFaqItems,
} from '../../data/chauffage';

const title = 'Dépannage chauffage Hauts-de-France | Belkhir Dépannage';
const description =
  'Chaudière arrêtée, radiateurs froids ou chauffage irrégulier ? Belkhir Dépannage qualifie ' +
  'votre urgence chauffage dans les Hauts-de-France, 24h/24 et 7j/7.';

// Donnée structurée FAQPage : alimentée par EXACTEMENT les mêmes questions
// et réponses que celles rendues visuellement par <Faq items={...} />
// ci-dessous (même tableau `chauffageFaqItems`) — jamais des données
// structurées différentes du contenu affiché.
const faqSchema = buildFaqPageSchema(chauffageFaqItems);
---

<BaseLayout
  title={title}
  description={description}
  path="/chauffage/"
  hasMobileCallBar
  structuredData={[faqSchema]}
>
  <Fragment slot="header">
    <AvailabilityBar />
    <Navbar />
    <MobileDrawer />
  </Fragment>

  <Hero />

  <SafetyTips
    id="urgences-chauffage"
    eyebrow="VOTRE SÉCURITÉ D’ABORD"
    title="Que faire lorsque le chauffage ne fonctionne plus correctement ?"
    intro="Une panne de chauffage ne nécessite pas de démonter l’appareil pour fournir des informations utiles. Quelques observations simples permettent déjà de limiter les risques et de mieux qualifier la demande."
    tips={chauffageSafetyTips}
    note={chauffageSafetyNote}
  >
    <SafetyAlert
      slot="alert"
      title={chauffageSafetyAlertTitle}
      text={chauffageSafetyAlertText}
      additionalText={chauffageSafetyAlertAdditionalText}
      contacts={chauffageSafetyAlertContacts}
      disclaimer={chauffageSafetyAlertDisclaimer}
    />
  </SafetyTips>

  <ReassuranceCallout
    id="appel-chauffage"
    eyebrow="VOUS N’AVEZ PAS BESOIN DE CONNAÎTRE LA PANNE"
    title="Décrivez les signes observés, nous vous aidons à qualifier la situation"
    text="Une pièce qui reste froide, un voyant, un code, une pression inhabituelle ou un bruit nouveau suffit pour commencer. Lors de l’appel, notre équipe recueille les informations utiles, distingue la panne courante d’une situation nécessitant une mise en sécurité et organise la suite adaptée."
    points={chauffageReassurancePoints}
    ctaLabel="Appeler Belkhir Dépannage"
    phone={siteConfig.emergencyPhone}
  />

  <Process
    id="prise-en-charge-chauffage"
    eyebrow="UNE PRISE EN CHARGE CLAIRE"
    steps={chauffageProcessSteps}
    tone="light"
  >
    <Fragment slot="title"
      >Comment se déroule un <span class="process__accent">dépannage chauffage</span> ?</Fragment
    >
    <Fragment slot="lead"></Fragment>
    <Fragment slot="banner"></Fragment>
  </Process>

  <CoverageSummary
    id="zone-chauffage"
    eyebrow="UNE ÉQUIPE MOBILE"
    title="Dépannage chauffage dans les Hauts-de-France"
    titleAccent="Hauts-de-France"
    intro={chauffageCoverageIntro}
    zones={coverageZones}
    ctaLabel="Vérifier mon secteur"
    phone={siteConfig.standardPhone}
    ctaHref={`${import.meta.env.BASE_URL}zones-intervention/`}
  />

  <Reviews
    id="avis-chauffage"
    eyebrow="LA CONFIANCE SE CONSTRUIT SUR LE TERRAIN"
    title="L’expérience de nos clients"
    intro="Emplacement réservé à connecter à notre fiche Google — aucun avis n’est inventé ici."
  />

  <Faq
    id="faq-chauffage"
    eyebrow="QUESTIONS FRÉQUENTES"
    title="Avant d’appeler pour un problème de chauffage"
    items={chauffageFaqItems}
    tone="dark"
  />

  <Footer slot="footer" />
  <MobileCallBar slot="mobile-call-bar" />
</BaseLayout>

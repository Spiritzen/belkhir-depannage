---
/**
 * Avis clients (section 18 du prompt de mission). Grille sobre, aucun faux
 * nom ni faux commentaire présenté comme réel — blocs « Avis Google à
 * connecter » explicitement mock. Pas d'intégration de l'API Google dans ce
 * sprint.
 *
 * Rendu paramétrable (micro-sprint 2 page plomberie, 04/09/2026) : `id`,
 * `eyebrow`, `title` et `intro` acceptent une valeur différente par page
 * métier, avec pour valeur par défaut EXACTEMENT le contenu actuel de la
 * landing (aucun `eyebrow` sur la landing, jamais rendu par défaut) — un
 * appel sans props (`<Reviews />`, voir src/pages/index.astro, inchangé)
 * produit donc un rendu strictement identique à avant. Toujours la même
 * donnée `reviewsPreview` (placeholders honnêtes, jamais un faux
 * témoignage) : aucune deuxième source créée pour une page métier.
 */
import Icon from '../ui/Icon.astro';
import { reviewsPreview } from '../../data/landing';

interface Props {
  id?: string;
  headingId?: string;
  /** Absente par défaut : la landing n'affiche aucun surtitre ici. */
  eyebrow?: string;
  title?: string;
  intro?: string;
}

const {
  id = 'avis',
  headingId = 'reviews-title',
  eyebrow,
  title = 'Avis clients',
  intro = 'Emplacement réservé à connecter à notre fiche Google — aucun avis n’est inventé ici.',
} = Astro.props;
---

<section class="reviews" id={id} aria-labelledby={headingId}>
  <div class="container">
    <div class="section-heading" data-reveal="up">
      {
        eyebrow && (
          <p class="reviews__eyebrow">
            <span class="reviews__eyebrow-bar" aria-hidden="true" />
            {eyebrow}
          </p>
        )
      }
      <h2 id={headingId}>{title}</h2>
      <p>{intro}</p>
    </div>

    <div class="reviews__grid" data-reveal-group="reviews">
      {
        reviewsPreview.map(() => (
          <article class="reviews__card" data-reveal="up" aria-label="Avis Google à connecter">
            <span class="reviews__stars" aria-hidden="true">
              {Array.from({ length: 5 }).map(() => (
                <Icon name="star" class="reviews__star" />
              ))}
            </span>
            <p class="reviews__placeholder">Avis Google à connecter</p>
            <p class="reviews__date">Date à venir</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Surtitre optionnel (micro-sprint 2 page plomberie, 04/09/2026) : jamais
     rendu sur la landing (prop `eyebrow` absente par défaut, voir
     frontmatter), donc sans aucun effet sur son rendu actuel. Même recette
     que l'eyebrow déjà utilisé ailleurs sur le site (EmergencySelector,
     ServicesAccordion, Process, Coverage) — aucune nouvelle valeur. */
  .reviews__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-brand);
    text-transform: uppercase;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    margin-bottom: 0.9rem;
  }

  .reviews__eyebrow-bar {
    width: 28px;
    height: 2px;
    border-radius: 999px;
    background: var(--color-brand);
  }

  .reviews {
    /* Retouche 04 (Hero) : le badge Google du Hero pointe vers cette section
       (id="avis", déjà réelle) tant qu'aucune URL Google Business validée
       n'est disponible. scroll-margin-top garantit qu'un clic ne laisse pas
       la section masquée sous la navbar sticky — seul ajout, aucun
       changement visuel de cette section. */
    scroll-margin-top: var(--header-total-height);
    padding-block: var(--space-7);
    /* Réordonnancement (01/09/2026) : la section occupe désormais la place
       narrative de l'ancien AvailabilityBlock, juste après « Nos domaines
       d'intervention » (fond anthracite très sombre). Fond blanc abricot
       identique à celui de « Quelle est votre urgence ? » (même valeur,
       aucun token centralisé n'existant pour cette teinte — voir
       EmergencySelector.astro) plutôt que le gris neutre précédent, pour
       une transition franche et cohérente entre les deux ambiances. */
    background: radial-gradient(circle at 20% 0%, rgba(255, 105, 0, 0.1), transparent 34%), #fff7f0;
  }

  .reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .reviews__card {
    background: var(--color-white);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    text-align: center;
  }

  .reviews__stars {
    display: inline-flex;
    gap: 0.15rem;
    margin-bottom: var(--space-2);
  }

  .reviews__star {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--color-gray-300);
  }

  .reviews__placeholder {
    font-weight: 700;
    color: var(--color-muted);
  }

  .reviews__date {
    font-size: 0.78rem;
    color: var(--color-gray-500);
    margin-top: 0.3rem;
  }

  @media (max-width: 56rem) {
    .reviews__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
/**
 * Moteur de recherche local « radar d'intervention » — page
 * `/zones-intervention/` (PROMPT_CLAUDE_CODE_PAGE_ZONES_INTERVENTION_
 * RADAR.txt, 04/09/2026).
 *
 * Combobox accessible qui recherche une commune ou un code postal parmi le
 * snapshot statique généré par `scripts/generate-coverage-communes.mjs`
 * (`public/data/communes-hauts-de-france.json`, source geo.api.gouv.fr —
 * jamais un appel réseau à cette API pendant la saisie du visiteur, voir la
 * section 2 du prompt). JavaScript natif léger, aucune dépendance nouvelle
 * (pas de Fuse.js).
 *
 * Une commune sélectionnée :
 *  1. met à jour la carte partagée (`CoverageMapGraphic`, rendue par
 *     `src/components/zones-intervention/Hero.astro`) en activant le
 *     groupe `.coverage-map__dept-group[data-department]` correspondant —
 *     ciblé via `document.querySelectorAll`, jamais une deuxième carte ;
 *  2. révèle la fiche de résultat ci-dessous ;
 *  3. pose `data-quote-location` sur le déclencheur `data-quote-trigger`
 *     « Demander un devis » de cette fiche — lu par `QuoteModal.astro`
 *     (extension documentée de son mécanisme d'ouverture existant, jamais
 *     une deuxième modale, jamais d'accès global fragile).
 *
 * Aucun stockage (`localStorage`/`sessionStorage`/cookie), aucun envoi
 * réseau de la saisie, aucun historique conservé.
 */
import Icon from '../ui/Icon.astro';
import { getPhoneCta } from '../../lib/phone';
import { siteConfig } from '../../lib/site-config';

const emergencyCta = getPhoneCta(siteConfig.emergencyPhone);

// Toujours un vrai lien `tel:` (numéro d'urgence réel, versionné en dur —
// voir siteConfig.emergencyPhone) : jamais de bouton désactivé possible ici.
const emergencyHref = emergencyCta.kind === 'link' ? emergencyCta.href : null;

// Chemin du snapshot, construit avec le `base` Astro (jamais
// `/belkhir-depannage/` écrit en dur) — lu côté client via `dataset` plutôt
// que `import.meta.env` dans le <script> (aucun précédent de ce type dans
// le dépôt ; ce pont par attribut `data-*` reste cohérent avec le reste du
// site).
const communesJsonSrc = `${import.meta.env.BASE_URL}data/communes-hauts-de-france.json`;
---

<div class="coverage-checker" data-json-src={communesJsonSrc}>
  <div class="coverage-checker__search">
    <label for="coverage-checker-input" class="coverage-checker__label">
      Votre commune ou votre code postal
    </label>
    <div class="coverage-checker__input-wrap">
      <Icon name="search" class="coverage-checker__input-icon" />
      <input
        id="coverage-checker-input"
        class="coverage-checker__input"
        type="text"
        role="combobox"
        aria-expanded="false"
        aria-controls="coverage-checker-listbox"
        aria-autocomplete="list"
        aria-describedby="coverage-checker-privacy-note"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        placeholder="Ex. Amiens ou 80000"
      />
    </div>
    <ul
      id="coverage-checker-listbox"
      class="coverage-checker__listbox"
      role="listbox"
      aria-label="Suggestions de communes"
      hidden
    >
    </ul>
    <p id="coverage-checker-privacy-note" class="coverage-checker__privacy-note">
      La recherche est effectuée localement dans votre navigateur et n’est pas enregistrée.
    </p>
    <noscript>
      <p class="coverage-checker__noscript">
        La vérification interactive nécessite JavaScript. Appelez-nous directement pour confirmer
        votre secteur.
      </p>
    </noscript>
  </div>

  <div
    class="coverage-checker__result"
    id="coverage-checker-result"
    role="status"
    aria-live="polite"
  >
    <p class="coverage-checker__result-initial" id="coverage-checker-state-initial">
      Recherchez une commune pour obtenir une confirmation de secteur.
      {
        emergencyHref && (
          <a class="coverage-checker__inline-call" href={emergencyHref}>
            <Icon name="phone" class="coverage-checker__inline-call-icon" />
            Appeler en urgence
          </a>
        )
      }
    </p>

    <div
      class="coverage-checker__result-card"
      id="coverage-checker-state-recognized"
      data-state="recognized"
      hidden
    >
      <p class="coverage-checker__result-heading">
        <span id="coverage-checker-result-commune"></span> · <span id="coverage-checker-result-dept"
        ></span> (<span id="coverage-checker-result-dept-code"></span>)
      </p>
      <p class="coverage-checker__result-text">
        Cette commune fait partie du secteur d’intervention déclaré de Belkhir Dépannage. La
        possibilité de déplacement et le délai sont confirmés après qualification de votre
        situation.
      </p>
      <div class="coverage-checker__result-actions">
        {
          emergencyHref && (
            <a class="coverage-checker__cta coverage-checker__cta--call" href={emergencyHref}>
              <Icon name="phone" class="coverage-checker__cta-icon" />
              Appeler en urgence
            </a>
          )
        }
        <button
          type="button"
          class="coverage-checker__cta coverage-checker__cta--quote"
          id="coverage-checker-quote-cta"
          data-quote-trigger
        >
          <Icon name="arrow-right" class="coverage-checker__cta-icon" />
          Demander un devis
        </button>
      </div>
    </div>

    <div
      class="coverage-checker__result-card"
      id="coverage-checker-state-unrecognized"
      data-state="unrecognized"
      hidden
    >
      <p class="coverage-checker__result-text">
        Nous ne pouvons pas confirmer cette commune automatiquement. Vérifiez l’orthographe ou
        appelez-nous pour étudier votre demande.
      </p>
      {
        emergencyHref && (
          <div class="coverage-checker__result-actions">
            <a class="coverage-checker__cta coverage-checker__cta--call" href={emergencyHref}>
              <Icon name="phone" class="coverage-checker__cta-icon" />
              Appeler en urgence
            </a>
          </div>
        )
      }
    </div>

    <div
      class="coverage-checker__result-card"
      id="coverage-checker-state-error"
      data-state="error"
      hidden
    >
      <p class="coverage-checker__result-text">
        La vérification automatique est momentanément indisponible. Appelez-nous pour confirmer
        votre secteur.
      </p>
      {
        emergencyHref && (
          <div class="coverage-checker__result-actions">
            <a class="coverage-checker__cta coverage-checker__cta--call" href={emergencyHref}>
              <Icon name="phone" class="coverage-checker__cta-icon" />
              Appeler en urgence
            </a>
          </div>
        )
      }
    </div>
  </div>
</div>

<script>
  interface CommuneRecord {
    name: string;
    codeInsee: string;
    departmentCode: string;
    departmentName: string;
    postalCodes: string[];
    population: number | null;
  }

  interface CommunesSnapshot {
    meta: {
      source: string;
      generatedAt: string;
      departments: Array<{ code: string; name: string }>;
      communeCount: number;
    };
    communes: CommuneRecord[];
  }

  interface SearchableCommune extends CommuneRecord {
    _normalizedName: string;
  }

  const root = document.querySelector<HTMLElement>('.coverage-checker');
  if (!root) {
    throw new Error('Composant .coverage-checker introuvable.');
  }

  const input = document.getElementById('coverage-checker-input') as HTMLInputElement;
  const listbox = document.getElementById('coverage-checker-listbox') as HTMLUListElement;
  const stateInitial = document.getElementById('coverage-checker-state-initial')!;
  const stateRecognized = document.getElementById('coverage-checker-state-recognized')!;
  const stateUnrecognized = document.getElementById('coverage-checker-state-unrecognized')!;
  const stateError = document.getElementById('coverage-checker-state-error')!;
  const allStates = [stateInitial, stateRecognized, stateUnrecognized, stateError];

  const resultCommuneEl = document.getElementById('coverage-checker-result-commune')!;
  const resultDeptEl = document.getElementById('coverage-checker-result-dept')!;
  const resultDeptCodeEl = document.getElementById('coverage-checker-result-dept-code')!;
  const quoteCta = document.getElementById('coverage-checker-quote-cta') as HTMLButtonElement;

  const REDUCED_MOTION = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // -------------------------------------------------------------------
  // Normalisation (section 5 du prompt) : minuscules, NFD, suppression des
  // diacritiques, apostrophes/tirets/espaces uniformisés pour la clé de
  // recherche — le nom officiel affiché n'est, lui, jamais modifié.
  // -------------------------------------------------------------------
  function normalize(value: string): string {
    return value
      .toLowerCase()
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .replace(/[’´`]/g, "'")
      .replace(/[-\s]+/g, ' ')
      .trim();
  }

  let communes: SearchableCommune[] | null = null;
  let loadPromise: Promise<SearchableCommune[]> | null = null;

  function ensureLoaded(): Promise<SearchableCommune[]> {
    if (communes) return Promise.resolve(communes);
    if (loadPromise) return loadPromise;

    const src = root!.dataset.jsonSrc;
    if (!src) {
      return Promise.reject(new Error('Source du snapshot introuvable (data-json-src manquant).'));
    }

    loadPromise = fetch(src)
      .then((response) => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json() as Promise<CommunesSnapshot>;
      })
      .then((snapshot) => {
        communes = snapshot.communes.map((c) => ({ ...c, _normalizedName: normalize(c.name) }));
        return communes;
      })
      .catch((error) => {
        // Échec définitif : `loadPromise` reste résolu-rejeté (jamais
        // réessayé automatiquement), `ensureLoaded()` le retourne à nouveau
        // tel quel à chaque appel suivant — geré au point d'appel
        // (`handleInput`/`input focus`), voir l'état "error" plus bas.
        throw error;
      });

    return loadPromise;
  }

  // -------------------------------------------------------------------
  // Recherche et classement (section 5 du prompt).
  // -------------------------------------------------------------------
  function searchCommunes(query: string, pool: SearchableCommune[]): SearchableCommune[] {
    const trimmed = query.trim();
    if (trimmed.length === 0) return [];

    const digitsOnly = trimmed.replace(/[^0-9]/g, '');
    const isPostalQuery = digitsOnly.length > 0 && digitsOnly === trimmed;

    if (isPostalQuery) {
      // Un code de département seul (2 chiffres) filtre déjà utilement.
      if (digitsOnly.length < 2) return [];
      const matches: Array<{ commune: SearchableCommune; score: number }> = [];
      for (const commune of pool) {
        let best: number | null = null;
        for (const postal of commune.postalCodes) {
          if (postal === digitsOnly) {
            best = 0;
            break;
          }
          if (postal.startsWith(digitsOnly) && best === null) {
            best = 1;
          }
        }
        if (best !== null) matches.push({ commune, score: best });
      }
      matches.sort(
        (a, b) => a.score - b.score || (b.commune.population ?? 0) - (a.commune.population ?? 0),
      );
      return matches.slice(0, 8).map((m) => m.commune);
    }

    const normalizedQuery = normalize(trimmed);
    if (normalizedQuery.length < 2) return [];

    const matches: Array<{ commune: SearchableCommune; score: number }> = [];
    for (const commune of pool) {
      let score: number;
      if (commune._normalizedName === normalizedQuery) score = 0;
      else if (commune._normalizedName.startsWith(normalizedQuery)) score = 1;
      else if (commune._normalizedName.includes(normalizedQuery)) score = 2;
      else continue;
      matches.push({ commune, score });
    }
    matches.sort(
      (a, b) => a.score - b.score || (b.commune.population ?? 0) - (a.commune.population ?? 0),
    );
    return matches.slice(0, 8).map((m) => m.commune);
  }

  // -------------------------------------------------------------------
  // Rendu des suggestions + combobox accessible (section 6 du prompt).
  // -------------------------------------------------------------------
  let currentResults: SearchableCommune[] = [];
  let activeIndex = -1;

  function closeListbox(): void {
    listbox.hidden = true;
    listbox.replaceChildren();
    input.setAttribute('aria-expanded', 'false');
    input.removeAttribute('aria-activedescendant');
    activeIndex = -1;
  }

  function formatSuggestion(commune: CommuneRecord): string {
    const postal = commune.postalCodes[0] ?? '';
    return `${commune.name} — ${postal} — ${commune.departmentName} (${commune.departmentCode})`;
  }

  function renderSuggestions(results: SearchableCommune[]): void {
    currentResults = results;
    activeIndex = -1;
    listbox.replaceChildren();

    if (results.length === 0) {
      closeListbox();
      return;
    }

    results.forEach((commune, index) => {
      const option = document.createElement('li');
      option.id = `coverage-checker-option-${index}`;
      option.setAttribute('role', 'option');
      option.setAttribute('aria-selected', 'false');
      option.className = 'coverage-checker__option';
      option.textContent = formatSuggestion(commune);
      option.dataset.index = String(index);
      option.addEventListener('pointerdown', (event) => {
        // `pointerdown` (jamais `click`) : se déclenche avant le `blur` du
        // champ, la sélection tactile/souris fonctionne donc de façon fiable
        // (même principe que la fermeture extérieure de QuoteModal.astro).
        event.preventDefault();
        selectCommune(commune);
      });
      listbox.append(option);
    });

    listbox.hidden = false;
    input.setAttribute('aria-expanded', 'true');
  }

  function setActiveOption(index: number): void {
    const options = Array.from(listbox.querySelectorAll<HTMLLIElement>('[role="option"]'));
    for (const option of options) {
      option.classList.remove('is-active');
      option.setAttribute('aria-selected', 'false');
    }
    if (index >= 0 && index < options.length) {
      const option = options[index];
      option.classList.add('is-active');
      option.setAttribute('aria-selected', 'true');
      option.scrollIntoView({ block: 'nearest' });
      input.setAttribute('aria-activedescendant', option.id);
      activeIndex = index;
    } else {
      input.removeAttribute('aria-activedescendant');
      activeIndex = -1;
    }
  }

  // -------------------------------------------------------------------
  // Carte : active le département correspondant (section 8 du prompt).
  // Cible `.coverage-map__dept-group`, rendu par le composant partagé
  // CoverageMapGraphic (Hero.astro de cette page) — jamais une deuxième
  // carte, jamais de duplication des contours.
  // -------------------------------------------------------------------
  function activateDepartment(code: string): void {
    const groups = document.querySelectorAll<SVGGElement>('.coverage-map__dept-group');
    for (const group of groups) {
      group.classList.remove('is-active', 'coverage-checker-pulse');
    }
    const target = document.querySelector<SVGGElement>(
      `.coverage-map__dept-group[data-department="${code}"]`,
    );
    if (!target) return;
    target.classList.add('is-active');
    if (!REDUCED_MOTION) {
      target.classList.add('coverage-checker-pulse');
      target.addEventListener(
        'animationend',
        () => target.classList.remove('coverage-checker-pulse'),
        { once: true },
      );
    }
  }

  // -------------------------------------------------------------------
  // Sélection d'une commune : révèle le résultat, active le département,
  // préremplit le déclencheur de la modale de devis (section 9 du prompt).
  // -------------------------------------------------------------------
  function showState(target: HTMLElement): void {
    for (const state of allStates) {
      const isTarget = state === target;
      state.hidden = !isTarget;
      state.classList.toggle('is-visible', isTarget && !REDUCED_MOTION);
    }
  }

  function selectCommune(commune: CommuneRecord): void {
    input.value = commune.name;
    closeListbox();

    resultCommuneEl.textContent = commune.name;
    resultDeptEl.textContent = commune.departmentName;
    resultDeptCodeEl.textContent = commune.departmentCode;

    const postal = commune.postalCodes[0] ?? '';
    // Lu par QuoteModal.astro (extension documentée d'`openModal`) : jamais
    // de valeur HTML, une simple chaîne texte issue du snapshot officiel.
    quoteCta.dataset.quoteLocation = postal ? `${commune.name} — ${postal}` : commune.name;

    activateDepartment(commune.departmentCode);
    showState(stateRecognized);
  }

  function showUnrecognized(): void {
    showState(stateUnrecognized);
  }

  function showError(): void {
    showState(stateError);
  }

  function resetToInitial(): void {
    showState(stateInitial);
  }

  // -------------------------------------------------------------------
  // Interactions champ + clavier (section 6 du prompt).
  // -------------------------------------------------------------------
  input.addEventListener('focus', () => {
    ensureLoaded().catch(() => {
      /* géré au moment de la recherche, voir handleInput */
    });
  });

  function handleInput(): void {
    const value = input.value;

    if (value.trim().length === 0) {
      closeListbox();
      resetToInitial();
      return;
    }

    ensureLoaded()
      .then((pool) => {
        const results = searchCommunes(value, pool);
        renderSuggestions(results);
        // Une saisie non vide sans aucune correspondance affiche l'état
        // "non reconnue" — jamais une sélection automatique et jamais un
        // verdict "non desservie" (section 7 du prompt).
        if (results.length === 0) {
          showUnrecognized();
        }
      })
      .catch(() => {
        closeListbox();
        showError();
      });
  }

  input.addEventListener('input', handleInput);

  input.addEventListener('keydown', (event) => {
    if (listbox.hidden && event.key !== 'Escape') return;

    switch (event.key) {
      case 'ArrowDown':
        event.preventDefault();
        setActiveOption(Math.min(activeIndex + 1, currentResults.length - 1));
        break;
      case 'ArrowUp':
        event.preventDefault();
        setActiveOption(Math.max(activeIndex - 1, 0));
        break;
      case 'Enter':
        event.preventDefault();
        if (activeIndex >= 0 && currentResults[activeIndex]) {
          selectCommune(currentResults[activeIndex]);
        } else if (currentResults.length === 1) {
          // Une seule proposition : non ambiguë, une confirmation Entrée
          // suffit sans navigation clavier préalable.
          selectCommune(currentResults[0]);
        }
        break;
      case 'Escape':
        // Ferme les suggestions sans quitter la page ni vider le champ.
        closeListbox();
        break;
      default:
        break;
    }
  });

  // Perte de focus (clic ailleurs, Tab) : referme proprement la liste.
  root.addEventListener('focusout', (event) => {
    if (root!.contains(event.relatedTarget as Node | null)) return;
    closeListbox();
  });
</script>

<style is:global>
  /*
   * Impulsion de sélection sur la carte (section 8 du prompt) : one-shot,
   * jamais en boucle, uniquement `filter` — aucune incidence sur la mise en
   * page, aucun tremblement. Cible `.coverage-map__dept-group`, rendu par
   * le composant partagé CoverageMapGraphic (un autre composant : `:global`
   * nécessaire, même principe déjà documenté pour `.process__accent` et
   * dans CoverageMapGraphic.astro lui-même).
   */
  @keyframes coverage-checker-pulse {
    0% {
      filter: drop-shadow(0 0 7px rgba(255, 105, 0, 0.55));
    }
    40% {
      filter: drop-shadow(0 0 17px rgba(255, 105, 0, 0.9));
    }
    100% {
      filter: drop-shadow(0 0 7px rgba(255, 105, 0, 0.55));
    }
  }

  .coverage-map__dept-group.coverage-checker-pulse .coverage-map__dept {
    animation: coverage-checker-pulse 650ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .coverage-map__dept-group.coverage-checker-pulse .coverage-map__dept {
      animation: none;
    }
  }
</style>

<style>
  .coverage-checker {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .coverage-checker__label {
    display: block;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-white);
    margin-bottom: 0.5rem;
  }

  .coverage-checker__input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .coverage-checker__input-icon {
    position: absolute;
    left: 1rem;
    width: 1.15rem;
    height: 1.15rem;
    color: var(--color-orange-500);
    pointer-events: none;
  }

  .coverage-checker__input {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.85rem 1rem 0.85rem 2.75rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-white);
    font: inherit;
    font-size: 1.05rem;
  }

  .coverage-checker__input::placeholder {
    color: var(--color-gray-300);
  }

  .coverage-checker__input:focus-visible {
    border-color: var(--color-orange-500);
  }

  .coverage-checker__listbox {
    position: relative;
    z-index: 2;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0.4rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: var(--color-anthracite-800);
    box-shadow: var(--shadow-lg);
    max-height: 16rem;
    overflow-y: auto;
  }

  .coverage-checker__option {
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--color-white);
    font-size: 0.92rem;
    cursor: pointer;
  }

  .coverage-checker__option.is-active,
  .coverage-checker__option:hover {
    background: rgba(255, 105, 0, 0.22);
  }

  .coverage-checker__privacy-note {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-gray-300);
  }

  .coverage-checker__noscript {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--color-orange-100);
  }

  /* ---------- Résultat ---------- */

  .coverage-checker__result {
    min-height: 3rem;
  }

  /* CORRECTION (même défaut que celui trouvé et corrigé sur QuoteModal.astro
     le même jour, DOUBLE CORRECTION P0) : `display: flex` posé sans
     condition avait la même spécificité que la règle native
     `[hidden] { display: none }` — l'attribut `hidden` (posé par
     `showState()`) était donc silencieusement ignoré et ce paragraphe
     restait visible en même temps que la fiche de résultat. Réservé
     désormais à l'état réellement visible. */
  .coverage-checker__result-initial:not([hidden]) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-gray-300);
  }

  .coverage-checker__inline-call {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-orange-500);
    font-weight: 700;
    text-decoration: none;
  }

  .coverage-checker__inline-call:hover,
  .coverage-checker__inline-call:focus-visible {
    text-decoration: underline;
  }

  .coverage-checker__inline-call-icon {
    width: 0.95rem;
    height: 0.95rem;
  }

  .coverage-checker__result-card {
    padding: 1.15rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 105, 0, 0.3);
    background: rgba(255, 105, 0, 0.08);
    opacity: 1;
    transform: none;
  }

  .coverage-checker__result-card.is-visible {
    animation: coverage-checker-reveal 420ms ease;
  }

  @keyframes coverage-checker-reveal {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .coverage-checker__result-heading {
    margin: 0 0 0.5rem;
